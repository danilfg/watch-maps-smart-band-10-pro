<template>
  <div class="screen" @swipe="handleSwipe">
    <text class="brand">WRISTROUTE</text>
    <text class="subtitle">ДЕМО · GPS НЕ ПОДКЛЮЧЁН</text>
    <div class="turn-panel">
      <text class="counter">{{counter}}</text>
      <text class="arrow">{{arrow}}</text>
      <text class="distance">{{distance}}</text>
      <text class="street">{{street}}</text>
      <text class="hint">{{hint}}</text>
    </div>
    <div class="buttons">
      <div class="back" @click="previous"><text class="button-label">◀ НАЗАД</text></div>
      <div class="next" @click="next"><text class="button-label">ДАЛЕЕ ▶</text></div>
    </div>
    <div class="exit" @click="exitApp"><text class="exit-label">✕  ВЫХОД</text></div>
    <text class="footer">Офлайн-макет, не навигация</text>
  </div>
</template>
<script>
import app from '@system.app'

const DEMO = [
  { arrow: '↑', distance: '350 м', street: 'Идите прямо', hint: 'Демо-маршрут · Москва' },
  { arrow: '↱', distance: '80 м', street: 'Поверните направо', hint: 'Вибрация пока выключена' },
  { arrow: '↰', distance: '120 м', street: 'Поверните налево', hint: 'GPS пока не проверен' },
  { arrow: '✓', distance: '0 м', street: 'Маршрут завершён', hint: 'Тест интерфейса окончен' }
]
export default {
  private: {
    index: 0,
    arrow: '↑',
    distance: '350 м',
    street: 'Идите прямо',
    hint: 'Демо-маршрут · Москва',
    counter: '1 / 4'
  },
  onInit() { this.applyStep() },
  onBackPress() { this.exitApp(); return true },
  handleSwipe(e) {
    if (!e) return
    if (e.direction === 'right') this.exitApp()
    else if (e.direction === 'left' || e.direction === 'up') this.next()
    else if (e.direction === 'down') this.previous()
  },
  next() {
    if (this.index < DEMO.length - 1) this.index += 1
    this.applyStep()
  },
  previous() {
    if (this.index > 0) this.index -= 1
    this.applyStep()
  },
  applyStep() {
    const step = DEMO[this.index]
    this.arrow = step.arrow
    this.distance = step.distance
    this.street = step.street
    this.hint = step.hint
    this.counter = (this.index + 1) + ' / ' + DEMO.length
  },
  exitApp() { app.terminate() }
}
</script>
<style>
.screen { width: 336px; height: 480px; background-color: #0c1b2d; align-items: center; flex-direction: column; overflow: hidden; }
.brand { margin-top: 25px; font-size: 25px; font-weight: bold; color: #9bcafe; text-align: center; }
.subtitle { margin-top: 6px; font-size: 12px; color: #aebed0; text-align: center; }
.turn-panel { width: 304px; height: 275px; background-color: #142c47; border-radius: 24px; align-items: center; flex-direction: column; margin-top: 12px; }
.counter { margin-top: 12px; font-size: 15px; color: #b6cbe2; text-align: center; }
.arrow { margin-top: 2px; font-size: 77px; font-weight: bold; color: #70b8ff; text-align: center; }
.distance { font-size: 39px; font-weight: bold; color: #ffffff; text-align: center; }
.street { margin-top: 5px; font-size: 20px; color: #ffffff; text-align: center; }
.hint { margin-top: 6px; font-size: 12px; color: #9cb7d2; text-align: center; }
.buttons { flex-direction: row; width: 310px; margin-top: 10px; justify-content: space-between; }
.back { width: 146px; height: 49px; background-color: #274766; border-radius: 14px; align-items: center; justify-content: center; }
.next { width: 146px; height: 49px; background-color: #176fc4; border-radius: 14px; align-items: center; justify-content: center; }
.button-label { color: #ffffff; font-weight: bold; font-size: 17px; text-align: center; }
.exit { width: 230px; height: 38px; margin-top: 9px; background-color: #4a2936; border-radius: 13px; align-items: center; justify-content: center; }
.exit-label { color: #ffcccc; font-size: 16px; font-weight: bold; text-align: center; }
.footer { margin-top: 4px; font-size: 11px; color: #90abc7; text-align: center; }
</style>